# =============================================================================
# Dilz Jackets - Backend Spring Boot Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# =============================================================================

# Server Port
PORT=8080

# Supabase PostgreSQL Database Credentials
DB_URL=jdbc:postgresql://<your-supabase-host>:5432/postgres?sslmode=require
DB_USERNAME=postgres.<your-project-ref>
DB_PASSWORD=your_db_password_here

# JWT Authentication Secret & Expiration
# Cryptographic key (min 256-bit / 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRATION_MS=36000000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080,https://*.vercel.app
