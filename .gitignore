# =============================================================================
# Root .gitignore for Dilz Jackets Full-Stack Project
# Covers: Angular Frontend, Spring Boot Backend, IDEs, and OS temporary files
# =============================================================================

# -----------------------------------------------------------------------------
# OS & System Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# Office / Temporary Autosave Files
~$*
~*.tmp
~WRL*.tmp
*.tmp
*.bak
*.swp
*~

# -----------------------------------------------------------------------------
# IDEs & Code Editors
# -----------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.code-workspace

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse / Spring Tool Suite (STS)
.apt_generated
.apt_generated_tests
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# Sublime Text
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# Backend: Java / Spring Boot / Maven
# -----------------------------------------------------------------------------
# Compiled class files
*.class

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven build directory
target/
**/target/
!**/src/main/**/target/
!**/src/test/**/target/

# Gradle build output (if applicable)
.gradle/
build/
**/build/
!**/src/main/**/build/
!**/src/test/**/build/

# Maven Wrapper JAR (downloaded dynamically via mvnw script)
.mvn/wrapper/maven-wrapper.jar
!/.mvn/wrapper/maven-wrapper.jar

# Spring Boot & Application Logs
logs/
**/logs/
*.log
spring.log

# Java Virtual Machine crash logs
hs_err_pid*
replay_pid*

# Spring Initializr help file (optional)
HELP.md

# -----------------------------------------------------------------------------
# Frontend: Angular / TypeScript / Node.js
# -----------------------------------------------------------------------------
# Node dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Angular build artifacts
dist/
**/dist/
tmp/
**/tmp/
out-tsc/
**/out-tsc/
bazel-out/
**/bazel-out/

# Angular persistent build cache
.angular/
**/.angular/
**/.angular/cache/

# Testing & Coverage
coverage/
**/coverage/
.nyc_output/
testem.log
/connect.lock
/libpeerconnection.log
typings/

# Styling cache
.sass-cache/
**/.sass-cache/

# -----------------------------------------------------------------------------
# Environment & Sensitive Credentials
# -----------------------------------------------------------------------------
.env
*.env
!.env.example
application-local.properties
application-local.yml
application-secret.properties
application-secret.yml
credentials.json
*.pem
*.key

*.docx